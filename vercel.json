{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/.well-known/assetlinks.json", "destination": "/api/auth/assetlinks" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
